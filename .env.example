# VELONA_API_KEY: Secret API key for Velona (Z.ai / GLM-5.3-Flash) - Required for all AI/model processing
VELONA_API_KEY=

# VELONA_MODEL: Model identifier for Velona (defaults to z-ai/glm-5.3-flash)
VELONA_MODEL=z-ai/glm-5.3-flash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID: Your Razorpay Key ID (rzp_test_...)
RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET: Your Razorpay Key Secret
RAZORPAY_KEY_SECRET=
