{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with full Credit Economy integration",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "standard", "premium", "admin"] },
        "creditWallet": {
          "type": "object",
          "properties": {
            "balance": { "type": "integer" },
            "usedThisMonth": { "type": "integer" },
            "totalEarned": { "type": "integer" },
            "expiringSoon": { "type": "integer" },
            "lastMonthlyGrant": { "type": "string", "format": "date-time" },
            "streak": { "type": "integer" },
            "lastLoginDate": { "type": "string", "format": "date" },
            "xp": { "type": "integer" },
            "level": { "type": "integer" },
            "referralCode": { "type": "string" },
            "referredBy": { "type": "string" },
            "hasUploadedResume": { "type": "boolean" },
            "hasCompletedAnalysis": { "type": "boolean" },
            "banReferrals": { "type": "boolean" },
            "unlockedBadges": { "type": "array", "items": { "type": "string" } }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "plan"]
    },
    "Transaction": {
      "title": "Credit Transaction",
      "description": "Record of credit spend or grant",
      "type": "object",
      "properties": {
        "amount": { "type": "integer" },
        "type": { "type": "string", "enum": ["grant", "referral", "achievement", "spend", "purchase", "refund", "bonus"] },
        "label": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["amount", "type", "label", "timestamp"]
    },
    "Resume": {
      "title": "Resume Data",
      "description": "Stored resume content and analysis",
      "type": "object",
      "properties": {
        "fileName": { "type": "string" },
        "content": { "type": "string" },
        "analysis": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Job": {
      "title": "Job Application",
      "description": "Details of a job application",
      "type": "object",
      "properties": {
        "company": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["Applied", "Interview", "Rejected", "Offer"] },
        "notes": { "type": "string" },
        "appliedDate": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["company", "role", "status"]
    },
    "Simulation": {
      "title": "Interview Simulation",
      "description": "Stored interview simulation session",
      "type": "object",
      "properties": {
        "jobDescription": { "type": "string" },
        "questions": { "type": "array" },
        "evaluations": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "OutreachContact": {
      "title": "Outreach Contact",
      "description": "Dynamic referral/outreach contact details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "company": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending Response", "Requested", "Referred"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "company", "email", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document with Credit details"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Ledger of user credit debits and credits"
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "User resumes and analysis"
    },
    "/users/{userId}/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job application tracking"
    },
    "/users/{userId}/simulations/{simulationId}": {
      "schema": "Simulation",
      "description": "Interview practice sessions"
    },
    "/users/{userId}/outreach_contacts/{contactId}": {
      "schema": "OutreachContact",
      "description": "Dynamic referral/outreach contact details"
    },
    "/config/creditCosts": {
      "schema": "object",
      "description": "Global configured credit costs"
    }
  }
}
