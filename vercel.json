{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aihireflow.in"
        }
      ],
      "destination": "https://www.aihireflow.in/:path*",
      "permanent": true
    },
    { "source": "/ats-resume-checker", "destination": "/resume-analyzer", "permanent": true },
    { "source": "/resume-builder", "destination": "/resume-editor", "permanent": true },
    { "source": "/ai-job-search", "destination": "/job-finder", "permanent": true },
    { "source": "/career-roadmap", "destination": "/career-advisor", "permanent": true },
    { "source": "/ai-interview-preparation", "destination": "/interview-lab", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true },
    { "source": "/terms-and-conditions", "destination": "/terms", "permanent": true },
    { "source": "/refund-policy", "destination": "/refund", "permanent": true },
    { "source": "/refund-and-cancellation", "destination": "/refund", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/resume-analyzer", "destination": "/resume-analyzer.html" },
    { "source": "/resume-editor", "destination": "/resume-editor.html" },
    { "source": "/job-finder", "destination": "/job-finder.html" },
    { "source": "/job-tracker", "destination": "/job-tracker.html" },
    { "source": "/career-advisor", "destination": "/career-advisor.html" },
    { "source": "/interview-lab", "destination": "/interview-lab.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/refund", "destination": "/refund.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/jobs", "destination": "/jobs.html" },
    { "source": "/tracker", "destination": "/tracker.html" },
    { "source": "/finder", "destination": "/finder.html" },
    { "source": "/analyzer", "destination": "/analyzer.html" },
    { "source": "/interview", "destination": "/interview.html" },
    { "source": "/learning", "destination": "/learning.html" },
    { "source": "/roadmap", "destination": "/roadmap.html" },
    { "source": "/editor", "destination": "/editor.html" },
    { "source": "/campus", "destination": "/campus.html" },
    { "source": "/outreach", "destination": "/outreach.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/credits", "destination": "/credits.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
