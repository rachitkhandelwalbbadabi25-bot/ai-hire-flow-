rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Globals & Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && 
             'email' in request.auth.token && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == "rrachitkhandelwal8@gmail.com"; 
    }
    
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Explicit test collection rule for instant connection handshake checks
    match /test/{docId} {
      allow read, write: if true;
    }

    // Config Collection for Credit Costs and App Settings (Publicly readable, admin writable)
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 1. User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return (!('email' in data) || data.email is string) &&
               (!('plan' in data) || data.plan in ['free', 'standard', 'premium', 'admin']);
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn();
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        ('plan' in incoming() && incoming().plan == 'admin') ? ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == "rrachitkhandelwal8@gmail.com") : true
      );

      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        ('plan' in incoming() && incoming().plan == 'admin') ? ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == "rrachitkhandelwal8@gmail.com") : true
      );

      // Support Sub-collections (Resumes, Jobs, Simulations, Transactions, Contacts, Config, Cache, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 5. Admins Collection (Direct Auth)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; 
    }
  }
}

