{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aihireflow.in"
        }
      ],
      "destination": "https://www.aihireflow.in/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/resume-analyzer", "destination": "/resume-analyzer.html" },
    { "source": "/resume-editor", "destination": "/resume-editor.html" },
    { "source": "/job-finder", "destination": "/job-finder.html" },
    { "source": "/job-tracker", "destination": "/job-tracker.html" },
    { "source": "/career-advisor", "destination": "/career-advisor.html" },
    { "source": "/interview-lab", "destination": "/interview-lab.html" },
    { "source": "/ats-resume-checker", "destination": "/resume-analyzer.html" },
    { "source": "/resume-builder", "destination": "/resume-editor.html" },
    { "source": "/ai-job-search", "destination": "/job-finder.html" },
    { "source": "/career-roadmap", "destination": "/career-advisor.html" },
    { "source": "/ai-interview-preparation", "destination": "/interview-lab.html" },
    { "source": "/((?!api/|.*\\.[\\w]+$).*)", "destination": "/index.html" }
  ]
}
